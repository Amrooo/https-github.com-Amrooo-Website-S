rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isVehicleOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() >= minLen &&
              request.resource.data[field].size() <= maxLen);
    }
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() < 50 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() < 100 &&
             isValidOptionalString('phone', 0, 20) &&
             isValidOptionalString('address', 0, 200) &&
             isValidOptionalString('idNumber', 0, 50) &&
             isValidOptionalString('photo', 0, 1000);
    }
    function isValidVehicle(data) {
      return data.keys().hasAll(['ownerId', 'make', 'model', 'plate']) &&
             data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() < 50 &&
             data.make is string && data.make.size() > 0 && data.make.size() < 50 &&
             data.model is string && data.model.size() > 0 && data.model.size() < 50 &&
             data.plate is string && data.plate.size() > 0 && data.plate.size() < 20 &&
             isValidOptionalString('uid', 0, 50) &&
             isValidOptionalString('year', 0, 10) &&
             isValidOptionalString('color', 0, 30) &&
             isValidOptionalString('insuranceStatus', 0, 50) &&
             isValidOptionalString('insuranceProvider', 0, 100) &&
             isValidOptionalString('lastService', 0, 50) &&
             isValidOptionalString('registrationExpiry', 0, 50);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidUser(request.resource.data) && request.resource.data.uid == uid;
      allow update: if isOwner(uid) && isValidUser(request.resource.data) && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(uid);
    }

    match /vehicles/{vehicleId} {
      allow read: if isVehicleOwner() || (isAuthenticated() && request.resource.data.ownerId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid && isValidVehicle(request.resource.data);
      allow update: if isVehicleOwner() && isValidVehicle(request.resource.data) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isVehicleOwner();
    }
  }
}
